generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  NEED_INFO
  QUOTATION_SENT
  AWAITING_APPROVAL
  PAYMENT_PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

model User {
  id           String   @id @default(cuid())
  name         String
  businessName String?
  email        String   @unique
  mobile       String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests      ServiceRequest[] @relation("CustomerRequests")
  assigned      ServiceRequest[] @relation("AssignedRequests")
  notes         RequestNote[]
  resetTokens   PasswordReset[]
  auditLogs     AuditLog[]
  quotesCreated Quotation[] @relation("QuoteCreatedBy")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  summary      String
  description  String
  deliverables String[]
  process      String[]
  priceFrom    Int? // indicative price, INR
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  requests ServiceRequest[]
}

model ServiceRequest {
  id          String        @id @default(cuid())
  number      Int           @unique @default(autoincrement())
  customerId  String
  serviceId   String
  title       String
  scope       String
  budget      String?
  deadline    DateTime?
  status      RequestStatus @default(SUBMITTED)
  priority    Priority      @default(NORMAL)
  assignedToId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer    User          @relation("CustomerRequests", fields: [customerId], references: [id])
  assignedTo  User?         @relation("AssignedRequests", fields: [assignedToId], references: [id])
  service     Service       @relation(fields: [serviceId], references: [id])
  attachments Attachment[]
  notes       RequestNote[]
  quotations  Quotation[]

  @@index([customerId])
  @@index([status])
}

model Attachment {
  id         String   @id @default(cuid())
  requestId  String
  fileName   String
  storedName String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// A message on a request. internal = staff-only note; otherwise visible to the customer.
model RequestNote {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REVISION_REQUESTED
  DECLINED
  SUPERSEDED
}

// Money is stored in paise (integer) to avoid rounding errors. Tax rate is in basis points (1800 = 18%).
model Quotation {
  id             String      @id @default(cuid())
  number         String?     @unique // BPX-Q-YYYY-0001, assigned when sent (drafts have none, keeping numbers gap-free)
  requestId      String
  status         QuoteStatus @default(DRAFT)
  scope          String
  milestones     String?
  paymentTerms   String?
  validUntil     DateTime
  discount       Int         @default(0)
  taxRateBp      Int         @default(1800)
  advancePercent Int         @default(50)
  subtotal       Int         @default(0)
  taxAmount      Int         @default(0)
  total          Int         @default(0)
  customerNote   String?
  sentAt         DateTime?
  respondedAt    DateTime?
  createdById    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  request   ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy User            @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  items     QuotationItem[]

  @@index([requestId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  description String
  quantity    Int
  unitPrice   Int
  sortOrder   Int       @default(0)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

// Per-year document counters, e.g. key "Q-2026" for quotation numbers.
model Counter {
  key   String @id
  value Int    @default(0)
}
